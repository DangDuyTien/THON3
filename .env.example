# Frontend (Render Static Site): set this during build to your Render API URL.
VITE_API_BASE_URL=https://thon3.onrender.com

# Backend (Render Web Service)
PORT=8787
API_PORT=8787
CORS_ORIGIN=https://thon3-1.onrender.com
NODE_ENV=production
SESSION_SECRET=replace-with-at-least-48-random-characters
SESSION_TTL_HOURS=12
# Optional separate HMAC key for hashed IP/rate-limit identifiers.
SECURITY_HASH_SECRET=
# Set to true only when frontend and API are genuinely cross-site.
CROSS_SITE_COOKIES=false

# TiDB Cloud (MySQL compatible). TiDB Cloud requires TLS.
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=xa_me_linh
MYSQL_USER=replace-with-tidb-user
MYSQL_PASSWORD=replace-with-tidb-password
MYSQL_SSL=true
# Optional local path to TiDB Cloud CA certificate when required.
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=5

# ImageKit Free stores the files; TiDB only keeps their URLs and metadata.
# Keep the private key in Render secrets only, never in VITE_* variables.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/thon3/site
# ImageKit Free accepts images up to 25 MB. Uploads are queued one by one.
MAX_MEDIA_BYTES=26214400
ADMIN_EMAIL=tienddph50842@gmail.com
# Must be 16–18 random digits; set this only in the deployment secret store.
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Quản trị viên

# Email OTP and password recovery. Keep ADMIN_EMAIL_OTP_REQUIRED=false until
# the sender is verified and a test email has arrived successfully.
RESEND_API_KEY=
SECURITY_EMAIL_FROM=THÔN 3 <security@your-verified-domain.example>
ADMIN_EMAIL_OTP_REQUIRED=false
