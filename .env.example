# Frontend (Render Static Site): set this during build to your Render API URL.
VITE_API_BASE_URL=https://your-api.onrender.com

# Backend (Render Web Service)
PORT=8787
API_PORT=8787
CORS_ORIGIN=https://your-site.onrender.com
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
# Set to true only when frontend and API are genuinely cross-site.
CROSS_SITE_COOKIES=false

# TiDB Cloud (MySQL compatible). TiDB Cloud requires TLS.
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DATABASE=xa_me_linh
MYSQL_USER=replace-with-tidb-user
MYSQL_PASSWORD=replace-with-tidb-password
MYSQL_SSL=true
# Optional local path to TiDB Cloud CA certificate when required.
MYSQL_SSL_CA=
MYSQL_CONNECTION_LIMIT=5

# TiDB BLOB storage: keep this conservative for the free tier.
MAX_MEDIA_BYTES=15728640
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Quản trị viên
