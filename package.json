{
  "name": "xa-me-linh-hanoi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs --host 0.0.0.0",
    "dev:full": "node scripts/dev-full.mjs",
    "server": "node server/index.mjs",
    "db:migrate": "node server/scripts/migrate.mjs",
    "db:seed-admin": "node server/scripts/seed-admin.mjs",
    "build": "vite build",
    "build:check": "node scripts/validate-cms-media.js && vite build && node scripts/check-bundle-budget.js",
    "budget": "node scripts/check-bundle-budget.js",
    "media:validate": "node scripts/validate-cms-media.js",
    "media:variants": "node scripts/generate-media-variants.mjs",
    "perf:lighthouse": "lhci autorun --config=lighthouserc.desktop.cjs && lhci autorun --config=lighthouserc.mobile.cjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lenis": "^1.3.25",
    "lucide-react": "1.28.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-vitals": "^6.0.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "6.4.3"
  }
}
